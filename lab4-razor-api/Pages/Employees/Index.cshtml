@page
@model ProjectContractsPages.Pages.Employees.IndexModel
@{ ViewData["Title"] = "Працівники"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Працівники</h3>
    <a asp-page="Edit" class="btn btn-success"><i class="bi bi-plus-lg"></i> Додати працівника</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input asp-for="Search" class="form-control" placeholder="Пошук за прізвищем" /></div>
    <div class="col-md-3">
        <select asp-for="PositionId" asp-items="Model.PositionList" class="form-select"><option value="">Усі посади</option></select>
    </div>
    <div class="col-auto"><button class="btn btn-primary"><i class="bi bi-search"></i> Знайти</button></div>
</form>

<div class="card">
<table class="table table-hover mb-0">
    <thead class="table-light"><tr><th>ПІБ</th><th>Посада</th><th>Домашня адреса</th><th>Телефон</th><th>Характеристика</th><th></th></tr></thead>
    <tbody>
    @foreach (var e in Model.Employees)
    {
        <tr>
            <td>@e.FullName</td>
            <td>@e.Position.Title</td>
            <td>@e.Address</td>
            <td class="text-nowrap">@e.Phone</td>
            <td class="small text-muted">@e.Characteristic</td>
            <td class="text-end text-nowrap">
                <a asp-page="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                <a asp-page="Delete" asp-route-id="@e.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
            </td>
        </tr>
    }
    @if (Model.Employees.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Нічого не знайдено</td></tr> }
    </tbody>
</table>
</div>
