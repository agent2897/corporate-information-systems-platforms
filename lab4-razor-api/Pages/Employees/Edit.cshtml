@page "{id:int?}"
@model ProjectContractsPages.Pages.Employees.EditModel
@{ ViewData["Title"] = Model.Employee.Id == 0 ? "Новий працівник" : "Редагування працівника"; }

<h3 class="mb-3">@ViewData["Title"]</h3>
<div class="card p-4" style="max-width: 760px">
<form method="post" novalidate>
    <input type="hidden" asp-for="Employee.Id" />
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="Employee.LastName" class="form-label"></label><input asp-for="Employee.LastName" class="form-control" /><span asp-validation-for="Employee.LastName" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="Employee.FirstName" class="form-label"></label><input asp-for="Employee.FirstName" class="form-control" /><span asp-validation-for="Employee.FirstName" class="text-danger small"></span></div>
        <div class="col-md-4"><label asp-for="Employee.MiddleName" class="form-label"></label><input asp-for="Employee.MiddleName" class="form-control" /><span asp-validation-for="Employee.MiddleName" class="text-danger small"></span></div>
        <div class="col-md-6">
            <label asp-for="Employee.PositionId" class="form-label"></label>
            <select asp-for="Employee.PositionId" asp-items="Model.PositionList" class="form-select"><option value="0">— оберіть посаду —</option></select>
            <span asp-validation-for="Employee.PositionId" class="text-danger small"></span>
        </div>
        <div class="col-md-6"><label asp-for="Employee.Phone" class="form-label"></label><input asp-for="Employee.Phone" class="form-control" placeholder="+380XXXXXXXXX" /><span asp-validation-for="Employee.Phone" class="text-danger small"></span></div>
        <div class="col-12"><label asp-for="Employee.Address" class="form-label"></label><input asp-for="Employee.Address" class="form-control" /><span asp-validation-for="Employee.Address" class="text-danger small"></span></div>
        <div class="col-12"><label asp-for="Employee.Characteristic" class="form-label"></label><textarea asp-for="Employee.Characteristic" class="form-control" rows="2"></textarea></div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Зберегти</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Скасувати</a>
    </div>
</form>
</div>
