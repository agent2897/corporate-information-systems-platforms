@page "{id:int}"
@model ProjectContractsPages.Pages.Employees.DeleteModel
@{ ViewData["Title"] = "Видалення працівника"; }

<h3 class="mb-3">Видалити працівника?</h3>
<div class="card p-4" style="max-width: 640px">
    <p class="fs-5 mb-1"><b>@Model.Employee.FullName</b> — @Model.Employee.Position.Title</p>
    <p class="text-muted mb-0">@Model.Employee.Address</p>
    @if (Model.Employee.Participations.Count > 0)
    {
        <div class="alert alert-warning mt-3 mb-0">Разом з працівником буде видалено @Model.Employee.Participations.Count запис(и) про участь у проектах.</div>
    }
    <form method="post" class="mt-3">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Видалити</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Скасувати</a>
    </form>
</div>
