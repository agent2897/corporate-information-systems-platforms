@page
@model ProjectContractsPages.Pages.Positions.IndexModel
@{ ViewData["Title"] = "Посади"; }

<h3 class="mb-3">Посади та посадові оклади</h3>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Посада</th><th class="text-end">Оклад, грн</th><th class="text-center">Працівників</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model.Positions)
            {
                <tr class="@(p.Id == Model.Input.Id ? "table-warning" : "")">
                    <td>@p.Title</td>
                    <td class="text-end">@p.Salary.ToString("N2")</td>
                    <td class="text-center">@p.Employees.Count</td>
                    <td class="text-end text-nowrap">
                        <a asp-page="Index" asp-route-editId="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id" class="d-inline"
                              onsubmit="return confirm('Видалити посаду «@p.Title»?')">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card p-4">
            <h5>@(Model.Input.Id == 0 ? "Нова посада" : "Редагування посади")</h5>
            <form method="post" asp-page-handler="Save" novalidate>
                <input type="hidden" asp-for="Input.Id" />
                <div class="mb-3"><label asp-for="Input.Title" class="form-label"></label><input asp-for="Input.Title" class="form-control" /><span asp-validation-for="Input.Title" class="text-danger small"></span></div>
                <div class="mb-3"><label asp-for="Input.Salary" class="form-label"></label><input asp-for="Input.Salary" type="number" step="0.01" class="form-control" /><span asp-validation-for="Input.Salary" class="text-danger small"></span></div>
                <button class="btn btn-primary"><i class="bi bi-save"></i> Зберегти</button>
                @if (Model.Input.Id != 0) { <a asp-page="Index" class="btn btn-outline-secondary">Скасувати</a> }
            </form>
        </div>
    </div>
</div>
