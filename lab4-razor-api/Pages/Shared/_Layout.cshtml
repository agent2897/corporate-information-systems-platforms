<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Проектні договори</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #f3f5f4; }
        .card { border: 0; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        .table td, .table th { vertical-align: middle; }
    </style>
</head>
<body>
@{ var path = ViewContext.HttpContext.Request.Path.Value ?? ""; }
<nav class="navbar navbar-expand navbar-dark mb-4" style="background:#146c43">
    <div class="container">
        <a class="navbar-brand fw-semibold" asp-page="/Index"><i class="bi bi-briefcase-fill text-warning"></i> Проектні договори</a>
        <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link @(path.StartsWith("/Employees") ? "active" : "")" asp-page="/Employees/Index">Працівники</a></li>
            <li class="nav-item"><a class="nav-link @(path.StartsWith("/Positions") ? "active" : "")" asp-page="/Positions/Index">Посади</a></li>
            <li class="nav-item"><a class="nav-link @(path.StartsWith("/Projects") ? "active" : "")" asp-page="/Projects/Index">Проекти (Web API)</a></li>
            <li class="nav-item"><a class="nav-link" href="/api/projects" target="_blank"><i class="bi bi-braces"></i> API</a></li>
        </ul>
    </div>
</nav>
<main class="container pb-5">
    @if (TempData["Message"] is string msg)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle"></i> @msg</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @err</div>
    }
    @RenderBody()
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
