<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectContractsMaui.Views.ProjectEditPage"
             BackgroundColor="#f2f5f7">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="6">
            <Label Text="Назва проекту" Style="{StaticResource FieldLabel}" />
            <Entry x:Name="ProjectName" Placeholder="Назва" />
            <Label Text="Замовник" Style="{StaticResource FieldLabel}" />
            <Entry x:Name="Customer" Placeholder="Замовник" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout>
                    <Label Text="Дата початку" Style="{StaticResource FieldLabel}" />
                    <DatePicker x:Name="StartDate" Format="dd.MM.yyyy" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Дата закінчення" Style="{StaticResource FieldLabel}" />
                    <DatePicker x:Name="EndDate" Format="dd.MM.yyyy" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="Опис проекту" Style="{StaticResource FieldLabel}" />
            <Editor x:Name="Description" AutoSize="TextChanges" Placeholder="Опис" />
            <Label x:Name="Errors" TextColor="#c62828" IsVisible="False" Margin="0,8,0,0" />
            <Button Text="Зберегти" Clicked="OnSave" BackgroundColor="#1f6f78" Margin="0,12,0,0" />
            <Button x:Name="DeleteButton" Text="Видалити проект" Clicked="OnDelete" BackgroundColor="#c62828" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
