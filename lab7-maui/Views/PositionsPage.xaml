<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:ProjectContractsMaui.Models"
             x:Class="ProjectContractsMaui.Views.PositionsPage"
             Title="Посади та оклади"
             BackgroundColor="#f2f5f7">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Додати" Clicked="OnAdd" />
    </ContentPage.ToolbarItems>
    <CollectionView x:Name="List" SelectionMode="None" Margin="0,6">
        <CollectionView.Header>
            <Label Text="Натисніть на посаду, щоб змінити або видалити її" Margin="16,6" FontSize="13" TextColor="Gray" />
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="m:PositionItem">
                <Border Style="{StaticResource Card}" Margin="12,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTap" CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                        <Label Grid.Row="1" Text="{Binding Info}" FontSize="13" TextColor="Gray" />
                        <Label Grid.Column="1" Grid.RowSpan="2" Text="{Binding SalaryText}" FontSize="16"
                               TextColor="#1f6f78" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
