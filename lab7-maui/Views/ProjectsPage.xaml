<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:ProjectContractsMaui.Models"
             x:Class="ProjectContractsMaui.Views.ProjectsPage"
             Title="Проекти"
             BackgroundColor="#f2f5f7">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Додати" Clicked="OnAdd" />
    </ContentPage.ToolbarItems>
    <CollectionView x:Name="List" SelectionMode="None" Margin="0,6">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="m:ProjectItem">
                <Border Style="{StaticResource Card}" Margin="12,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTap" CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17" />
                        <Label Text="{Binding Customer}" TextColor="#1f6f78" />
                        <Label Text="{Binding Description}" FontSize="13" TextColor="#555" />
                        <Label Text="{Binding Period}" FontSize="13" />
                        <Label Text="{Binding Stats}" FontSize="13" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
