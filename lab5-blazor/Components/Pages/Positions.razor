@page "/positions"
@inject IDbContextFactory<ContractsContext> DbFactory

<PageTitle>Посади</PageTitle>
<h3 class="mb-3">Посади та посадові оклади</h3>
<Toast @ref="toast" />

<div class="card">
<table class="table table-hover mb-0">
    <thead class="table-light"><tr><th>Посада</th><th class="text-end" style="width:200px">Оклад, грн</th><th class="text-center">Працівників</th><th style="width:130px"></th></tr></thead>
    <tbody>
    @foreach (var p in list)
    {
        @if (editing?.Id == p.Id)
        {
            @* Редагування прямо в рядку таблиці *@
            <tr class="table-warning">
                <td><input class="form-control form-control-sm" @bind="editing.Title" /></td>
                <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="editing.Salary" /></td>
                <td class="text-center">@p.Employees.Count</td>
                <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-success" @onclick="Save"><i class="bi bi-check-lg"></i></button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => editing = null"><i class="bi bi-x-lg"></i></button>
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td>@p.Title</td>
                <td class="text-end">@p.Salary.ToString("N2")</td>
                <td class="text-center">@p.Employees.Count</td>
                <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(p)"><i class="bi bi-pencil"></i></button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(p)"><i class="bi bi-trash"></i></button>
                </td>
            </tr>
        }
    }
    @if (editing is { Id: 0 })
    {
        <tr class="table-success">
            <td><input class="form-control form-control-sm" placeholder="Назва посади" @bind="editing.Title" /></td>
            <td><input type="number" step="0.01" class="form-control form-control-sm text-end" @bind="editing.Salary" /></td>
            <td></td>
            <td class="text-end text-nowrap">
                <button class="btn btn-sm btn-success" @onclick="Save"><i class="bi bi-check-lg"></i></button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => editing = null"><i class="bi bi-x-lg"></i></button>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
<button class="btn btn-success mt-3" @onclick="() => editing = new Position()" disabled="@(editing is not null)"><i class="bi bi-plus-lg"></i> Додати посаду</button>

@code {
    List<Position> list = new();
    Position? editing;
    Toast toast = null!;

    protected override Task OnInitializedAsync() => Load();

    async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        list = (await db.Positions.Include(p => p.Employees).AsNoTracking().ToListAsync())
            .OrderByDescending(p => p.Salary).ToList();
    }

    void Edit(Position p) => editing = new Position { Id = p.Id, Title = p.Title, Salary = p.Salary };

    async Task Save()
    {
        var p = editing!;
        p.Title = p.Title.Trim();
        if (p.Title.Length == 0) { toast.Show("Вкажіть назву посади", true); return; }
        if (p.Salary <= 0) { toast.Show("Оклад має бути більшим за 0", true); return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Positions.AnyAsync(x => x.Title == p.Title && x.Id != p.Id))
        { toast.Show($"Посада «{p.Title}» вже існує", true); return; }

        if (p.Id == 0) db.Positions.Add(p); else db.Positions.Update(p);
        await db.SaveChangesAsync();
        editing = null;
        toast.Show($"Посаду «{p.Title}» збережено");
        await Load();
    }

    async Task Delete(Position p)
    {
        if (p.Employees.Count > 0)
        {
            toast.Show($"Посаду «{p.Title}» не можна видалити: її займають {p.Employees.Count} працівн.", true);
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Positions.Where(x => x.Id == p.Id).ExecuteDeleteAsync();
        toast.Show($"Посаду «{p.Title}» видалено");
        await Load();
    }
}
