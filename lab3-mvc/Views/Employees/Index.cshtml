@model List<Employee>
@{ ViewData["Title"] = "Працівники"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Працівники</h3>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Додати працівника</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Пошук за прізвищем" /></div>
    <div class="col-md-3">
        <select name="positionId" asp-items="ViewBag.PositionList" class="form-select"><option value="">Усі посади</option></select>
    </div>
    <div class="col-auto"><button class="btn btn-primary"><i class="bi bi-search"></i> Знайти</button></div>
</form>

<div class="card">
<table class="table table-hover mb-0">
    <thead class="table-light"><tr><th>ПІБ</th><th>Посада</th><th>Домашня адреса</th><th>Телефон</th><th class="text-center">Проектів</th><th></th></tr></thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td><a asp-action="Details" asp-route-id="@e.Id">@e.FullName</a></td>
            <td>@e.Position.Title</td>
            <td>@e.Address</td>
            <td class="text-nowrap">@e.Phone</td>
            <td class="text-center">@e.Participations.Count</td>
            <td class="text-end text-nowrap">
                <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary" title="Редагувати"><i class="bi bi-pencil"></i></a>
                <a asp-action="Delete" asp-route-id="@e.Id" class="btn btn-sm btn-outline-danger" title="Видалити"><i class="bi bi-trash"></i></a>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Нічого не знайдено</td></tr> }
    </tbody>
</table>
</div>
