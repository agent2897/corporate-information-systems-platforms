@model Employee
@{ ViewData["Title"] = Model.FullName; }

<h3 class="mb-3">@Model.FullName</h3>
<div class="card p-4 mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Посада</dt><dd class="col-sm-9">@Model.Position.Title (оклад @Model.Position.Salary.ToString("N2") грн)</dd>
        <dt class="col-sm-3">Домашня адреса</dt><dd class="col-sm-9">@Model.Address</dd>
        <dt class="col-sm-3">Телефон</dt><dd class="col-sm-9">@Model.Phone</dd>
        <dt class="col-sm-3">Характеристика</dt><dd class="col-sm-9">@Model.Characteristic</dd>
    </dl>
</div>
<div class="card p-3 mb-3">
    <h5>Участь у проектах</h5>
    <table class="table mb-0">
        <thead><tr><th>Проект</th><th>Період проекту</th><th class="text-end">Днів участі</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Participations)
        {
            <tr><td><a asp-controller="Projects" asp-action="Details" asp-route-id="@p.ProjectId">@p.Project.Name</a></td>
                <td>@p.Project.StartDate.ToString("dd.MM.yyyy") — @p.Project.EndDate.ToString("dd.MM.yyyy")</td>
                <td class="text-end">@p.DaysWorked</td></tr>
        }
        </tbody>
    </table>
</div>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Редагувати</a>
<a asp-action="Index" class="btn btn-outline-secondary">До списку</a>
