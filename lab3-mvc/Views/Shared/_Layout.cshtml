<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Проектні договори</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #f4f6fa; }
        .card { border: 0; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        .table td, .table th { vertical-align: middle; }
        .navbar-brand i { color: #ffc107; }
    </style>
</head>
<body>
@{ var c = ViewContext.RouteData.Values["controller"]?.ToString(); }
<nav class="navbar navbar-expand navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index"><i class="bi bi-briefcase-fill"></i> Проектні договори</a>
        <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link @(c == "Employees" ? "active" : "")" asp-controller="Employees" asp-action="Index">Працівники</a></li>
            <li class="nav-item"><a class="nav-link @(c == "Positions" ? "active" : "")" asp-controller="Positions" asp-action="Index">Посади</a></li>
            <li class="nav-item"><a class="nav-link @(c == "Projects" ? "active" : "")" asp-controller="Projects" asp-action="Index">Проекти</a></li>
            <li class="nav-item"><a class="nav-link @(c == "Participations" ? "active" : "")" asp-controller="Participations" asp-action="Index">Участь у проектах</a></li>
        </ul>
    </div>
</nav>
<main class="container pb-5">
    @if (TempData["Message"] is string msg)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle"></i> @msg</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @err</div>
    }
    @RenderBody()
</main>
</body>
</html>
