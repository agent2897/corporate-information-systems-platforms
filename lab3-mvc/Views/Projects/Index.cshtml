@model List<Project>
@{ ViewData["Title"] = "Проекти"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Проекти</h3>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Додати проект</a>
</div>
<div class="row g-3">
@foreach (var p in Model)
{
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <h5><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a></h5>
            <div class="text-muted mb-2"><i class="bi bi-building"></i> @p.Customer</div>
            <p>@p.Description</p>
            <div class="mb-3">
                <span class="badge text-bg-primary"><i class="bi bi-calendar-event"></i> @p.StartDate.ToString("dd.MM.yyyy") — @p.EndDate.ToString("dd.MM.yyyy")</span>
                <span class="badge text-bg-secondary">@((p.EndDate - p.StartDate).Days) дн.</span>
                <span class="badge text-bg-success"><i class="bi bi-people"></i> @p.Participations.Count учасн.</span>
            </div>
            <div class="mt-auto">
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Редагувати</a>
                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Видалити</a>
            </div>
        </div>
    </div>
}
</div>
