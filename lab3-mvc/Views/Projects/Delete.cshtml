@model Project
@{ ViewData["Title"] = "Видалення проекту"; }

<h3 class="mb-3">Видалити проект?</h3>
<div class="card p-4" style="max-width: 640px">
    <p class="fs-5 mb-1"><b>@Model.Name</b></p>
    <p class="text-muted mb-0">@Model.StartDate.ToString("dd.MM.yyyy") — @Model.EndDate.ToString("dd.MM.yyyy")</p>
    @if (Model.Participations.Count > 0)
    {
        <div class="alert alert-warning mt-3 mb-0">Буде також видалено @Model.Participations.Count запис(ів) про участь працівників.</div>
    }
    <partial name="_DeleteButtons" />
</div>
